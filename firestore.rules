rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can only read and write their own folder: users/<their Google account id>/...
    // Nobody (not even other signed-in users) can see anyone else's data.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{collection}/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && collection in ['months', 'accounts', 'categories', 'rules', 'goals', 'debts'];
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
